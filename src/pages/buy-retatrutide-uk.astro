---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductBySlug, products } from '../lib/products';
import { dualPrice, eurToGbp } from '../lib/constants';

const retatrutide = getProductBySlug('retatrutide');
if (!retatrutide) return Astro.redirect('/products');

const lowestVariant = retatrutide.variants.reduce((a, b) => a.priceEur < b.priceEur ? a : b);
const lowestGbp = eurToGbp(lowestVariant.priceEur);

const related = ['bpc-157', 'mots-c', 'bacteriostatic-water']
  .map((s) => products.find((p) => p.slug === s))
  .filter(Boolean) as typeof products;

const canonical = 'https://uk-peptides.eu/buy-retatrutide-uk';

// JSON-LD: Product + FAQPage + BreadcrumbList
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Retatrutide — Research Peptide UK',
  description: 'Retatrutide (LY3437943) triple GLP-1/GIP/glucagon receptor agonist for UK research use. Lyophilised, >99% purity, EU warehouse, 3-5 day tracked UK delivery.',
  image: `https://uk-peptides.eu${retatrutide.image}`,
  brand: { '@type': 'Brand', name: 'UK Peptides' },
  offers: retatrutide.variants.map((v) => ({
    '@type': 'Offer',
    price: eurToGbp(v.priceEur),
    priceCurrency: 'GBP',
    availability: 'https://schema.org/InStock',
    name: v.label,
    url: `https://uk-peptides.eu/checkout?variant=${v.id}`,
    priceValidUntil: '2027-12-31',
  })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '127',
  },
};

const faqs = [
  {
    q: 'Where can I buy retatrutide in the UK?',
    a: 'You can buy retatrutide for research use from UK Peptides (uk-peptides.eu). Stock is held in our EU warehouse and dispatched with 3-5 day tracked delivery to UK addresses. Supplied as lyophilised powder, >99% analytical purity, with Certificate of Analysis available on request.',
  },
  {
    q: 'Is retatrutide legal in the UK?',
    a: 'Retatrutide is not a controlled substance under the UK Misuse of Drugs Act 1971 or the Medicines Act 1968. It is sold strictly as a Research Use Only (RUO) compound for in vitro laboratory study. It is not approved as a medicine in the UK and must not be used as such.',
  },
  {
    q: 'How much does retatrutide cost in the UK?',
    a: `Retatrutide pricing at UK Peptides starts from £${lowestGbp} for a 10 mg lyophilised vial. Larger 20 mg and 30 mg vials are available at lower £/mg. All prices are billed in GBP, EUR price shown alongside for reference only.`,
  },
  {
    q: 'How is retatrutide shipped to the UK?',
    a: 'Orders are dispatched from our EU warehouse via tracked courier. Estimated transit time to UK addresses is 3-5 business days post-dispatch. Discreet packaging — no external labels indicating contents. Tracking link is emailed once your order ships.',
  },
  {
    q: 'How does retatrutide compare to tirzepatide and semaglutide?',
    a: 'Semaglutide activates GLP-1 only. Tirzepatide activates GLP-1 and GIP. Retatrutide adds glucagon receptor agonism — a third mechanism that increases hepatic lipid oxidation and thermogenesis. In the NEJM 2023 Phase II trial (n=338), the 12 mg retatrutide arm showed -24.2% mean body weight at 48 weeks, the strongest effect documented for a single peptide in clinical research.',
  },
  {
    q: 'What is the recommended storage for retatrutide?',
    a: 'Store lyophilised vials at -20°C, protected from light and moisture. Once reconstituted with bacteriostatic water, store at 2-8°C and use within 28 days. Shelf life of the lyophilised, sealed vial is 18 months.',
  },
  {
    q: 'Do I receive a Certificate of Analysis (COA)?',
    a: 'A Certificate of Analysis is available on request for any batch. Email contact@uk-peptides.eu with your order number after dispatch and we will forward the lab report (HPLC, mass spec) for the batch you received.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://uk-peptides.eu/' },
    { '@type': 'ListItem', position: 2, name: 'Buy Retatrutide UK', item: canonical },
  ],
};
---

<Base
