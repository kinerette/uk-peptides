  <!-- Breadcrumb -->
  <div style="background:var(--bg-alt);border-bottom:1px solid var(--border);padding:0.75rem 0;">
    <div class="container">
      <nav aria-label="Breadcrumb" style="font-size:0.8rem;color:var(--text-muted);">
        <a href="/" style="color:var(--text-muted);text-decoration:none;">Home</a>
