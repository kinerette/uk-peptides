---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../lib/products';

---

<Base
  title="Buy Research Peptides UK — 10 Compounds, EU Warehouse 2026"
  description="Browse 10 research peptides for UK scientists: retatrutide, BPC-157, TB-500, GHK-Cu, MOTS-c, NAD+, selank, semax, AHK-Cu, bac water. From £7. EU stock."
>
  <!-- Header -->
  <section style="background:var(--dark);padding:4rem 0 3rem;text-align:center;">
    <div class="container">
      <span class="section-label" style="color:#3B9FD4;">Research Catalogue</span>
      <h1 style="color:#fff;margin:0.5rem 0 1rem;max-width:640px;margin-left:auto;margin-right:auto;">
        Research Peptides UK — Complete Range
      </h1>
      <p style="color:rgba(255,255,255,0.6);max-width:560px;margin:0 auto 2rem;font-size:0.95rem;">
        All peptides are supplied as lyophilised powder, &gt;99% analytical purity, from EU warehouse stock.
        Secure checkout via Peptide-Pay. Discreet tracked shipping.
      </p>
      <div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:0.75rem;">
        {['EU Warehouse', '>99% Purity', 'Discreet Shipping', 'Secure Payment'].map((tag) => (
          <span style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:999px;padding:0.3rem 0.9rem;font-size:0.78rem;font-weight:600;color:rgba(255,255,255,0.7);">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Products grid -->
  <section class="section" style="background:var(--bg);">
    <div class="container">
      <div class="grid-3" id="productsGrid">
        {products.map((product) => (
          <div class="reveal">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <div style="margin-top:4rem;background:var(--white);border:1px solid var(--border);border-radius:var(--radius-xl);padding:2rem;text-align:center;">
        <h2 style="font-size:1.25rem;margin-bottom:0.5rem;">Pure Peptides UK — Why Quality Matters</h2>
        <p style="color:var(--text-muted);max-width:640px;margin:0 auto 1.25rem;font-size:0.9rem;line-height:1.7;">
          Research-grade purity is not a marketing claim — it determines whether your experimental results
          are reproducible and valid. All UK Peptides products are lyophilised to &gt;99% analytical standard,
          ensuring your research data holds up to scrutiny. We source exclusively from GMP-compliant
          synthesis facilities with full batch traceability.
        </p>
        <a href="/blog/uk-peptides-review-how-to-spot-quality" class="btn btn-outline">
          How to Spot Quality Peptides &rarr;
        </a>
      </div>
    </div>
  </section>

</Base>
