---
import Base from '../layouts/Base.astro';
import { products } from '../lib/products';

const featured = products.filter(p => p.featured).slice(0, 4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'UK Peptides Europe — EU Warehouse, No Customs',
  description: 'Research peptides for European researchers. EU warehouse, 3–5 day delivery, zero customs risk. The EU alternative with the same compounds, shipped from inside Europe.',
  url: 'https://uk-peptides.eu/uk-peptides-europe',
};
---

<Base
  title="Research Peptides Europe — EU Warehouse, 3-5 Day Delivery"
  description="Research peptides shipped from inside the EU — no customs, no border risk, 3-5 day tracked delivery to Germany, France, NL and across Europe."
  canonical="https://uk-peptides.eu/uk-peptides-europe"
  schema={schema}
>

  <!-- Hero -->
  <section style="background:var(--dark);padding:5rem 0 4rem;">
    <div class="container" style="max-width:860px;">
      <div style="text-align:center;">
        <span style="display:inline-block;background:rgba(59,159,212,0.15);color:#3B9FD4;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.3rem 0.85rem;border-radius:999px;border:1px solid rgba(59,159,212,0.3);margin-bottom:1.5rem;">
          EU WAREHOUSE · SHIPS FROM INSIDE THE EU
        </span>

        <h1 style="color:#fff;font-size:clamp(1.8rem,4.5vw,3rem);line-height:1.15;margin-bottom:1.25rem;">
          Research Peptides for European Researchers.<br/>
          <span style="color:#3B9FD4;">Shipped from inside the EU.</span>
        </h1>

        <p style="color:rgba(255,255,255,0.65);font-size:1.05rem;line-height:1.65;max-width:620px;margin:0 auto 2rem;">
          If you have been sourcing peptides from a UK supplier, you know the problem: customs delays, seizure risk, and unpredictable delivery. We hold stock inside the EU — your order moves as a standard European parcel, no border involved.
        </p>

        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/products" class="btn btn-primary" style="font-size:1rem;padding:0.8rem 2rem;">
            Browse EU Stock &rarr;
          </a>
          <a href="/faq" class="btn btn-outline" style="font-size:1rem;padding:0.8rem 2rem;color:#fff;border-color:rgba(255,255,255,0.3);">
            Delivery FAQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why EU section -->
  <section style="background:var(--bg-alt);padding:4rem 0;">
    <div class="container" style="max-width:900px;">
      <div style="text-align:center;margin-bottom:3rem;">
        <span class="section-label">Why EU warehouse matters</span>
        <h2 class="section-title" style="margin-top:0.5rem;">What changes when stock is inside the EU</h2>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">

        <div style="background:#fff;border-radius:var(--radius-xl);padding:2rem;border:1px solid var(--border);">
          <div style="font-size:1.5rem;margin-bottom:0.75rem;">📦</div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">No customs, no declarations</h3>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            EU-to-EU shipments are internal market movements. No CN22 forms, no customs officer discretion, no third-country import rules. The parcel moves like any domestic delivery.
          </p>
        </div>

        <div style="background:#fff;border-radius:var(--radius-xl);padding:2rem;border:1px solid var(--border);">
          <div style="font-size:1.5rem;margin-bottom:0.75rem;">⚡</div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">3–5 day tracked delivery</h3>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Germany in 2–3 days. France in 3–4 days. Netherlands in 1–2 days. Every order tracked from dispatch to doorstep via DHL, DPD, or PostNL.
          </p>
        </div>

        <div style="background:#fff;border-radius:var(--radius-xl);padding:2rem;border:1px solid var(--border);">
          <div style="font-size:1.5rem;margin-bottom:0.75rem;">🔒</div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">Zero seizure risk</h3>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            German Zoll, French douanes, Dutch customs — none of these touch an EU-to-EU parcel. Internal EU shipments are not subject to import screening or chemical declaration requirements.
          </p>
        </div>

        <div style="background:#fff;border-radius:var(--radius-xl);padding:2rem;border:1px solid var(--border);">
          <div style="font-size:1.5rem;margin-bottom:0.75rem;">🧪</div>
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:0.5rem;">&gt;99% purity, same compounds</h3>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Retatrutide, BPC-157, TB-500, GHK-Cu — the same research-grade compounds. The difference is geography, not quality. EU stock, EU logistics, EU delivery.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- UK vs EU comparison -->
  <section style="background:var(--bg);padding:4rem 0;">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center;margin-bottom:2.5rem;">
        <h2 class="section-title">UK import vs EU warehouse: the real difference</h2>
      </div>

      <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06);">
        <div style="display:grid;grid-template-columns:1fr 1fr;">
          <div style="background:#F8F9FA;padding:1rem 1.5rem;font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);">UK supplier → your address</div>
          <div style="background:rgba(59,159,212,0.06);padding:1rem 1.5rem;font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#3B9FD4;border-left:2px solid #3B9FD4;">EU warehouse → your address</div>
        </div>
        {[
          ['Third-country import — customs applies', 'Internal EU movement — no customs'],
          ['7–30 days (customs unpredictable)', '3–5 days tracked, guaranteed'],
          ['Seizure risk: real and documented', 'Seizure risk: zero'],
          ['Customs duty may apply above €150', 'No import duty, no VAT surprise'],
          ['Lost order: no EU recourse', 'Full EU consumer protection'],
          ['Temperature during customs: unknown', 'Cold chain maintained throughout'],
        ].map(([bad, good]) => (
          <div style="display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #F3F4F6;">
            <div style="padding:0.85rem 1.5rem;font-size:0.84rem;color:#9CA3AF;border-right:1px solid #F3F4F6;">
              <span style="color:#EF4444;font-weight:700;">✕ </span>{bad}
            </div>
            <div style="padding:0.85rem 1.5rem;font-size:0.84rem;color:#374151;background:rgba(59,159,212,0.03);border-left:2px solid #3B9FD4;">
              <span style="color:#3B9FD4;font-weight:700;">✓ </span>{good}
            </div>
          </div>
        ))}
        <div style="padding:1.5rem;text-align:center;border-top:1px solid #E5E7EB;">
          <a href="/products" class="btn btn-primary">Order from EU Stock &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section style="background:var(--bg-alt);padding:4rem 0;">
    <div class="container">
      <div style="text-align:center;margin-bottom:2.5rem;">
        <span class="section-label">All compounds in stock</span>
        <h2 class="section-title" style="margin-top:0.5rem;">Featured Research Peptides — EU Warehouse</h2>
      </div>
      <div class="grid-4">
        {featured.map(product => {
          const price = Math.min(...product.variants.map(v => v.priceEur));
          return (
            <article class="card" style="display:flex;flex-direction:column;">
              <a href={`/products/${product.slug}`} style="display:block;background:var(--bg);height:180px;display:flex;align-items:center;justify-content:center;padding:1.25rem;">
                <img src={product.image} alt={product.name} width="130" height="130" loading="lazy" style="object-fit:contain;height:130px;width:auto;" />
              </a>
              <div style="padding:1rem 1.25rem;flex:1;display:flex;flex-direction:column;gap:0.4rem;">
                <h3 style="font-size:1rem;font-weight:700;margin:0;">{product.name}</h3>
                <p style="font-size:0.78rem;color:var(--text-muted);flex:1;line-height:1.5;">{product.shortBenefit.slice(0, 80)}…</p>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.5rem;">
                  <span style="font-weight:700;font-size:1.05rem;">from €{price}</span>
                  <a href={`/products/${product.slug}`} class="btn btn-primary btn-sm">View</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:2rem;">
        <a href="/products" class="btn btn-outline">See All 10 Compounds &rarr;</a>
      </div>
    </div>
  </section>

  <!-- FAQ strip -->
  <section style="background:var(--bg);padding:3.5rem 0;">
    <div class="container" style="max-width:760px;">
      <h2 class="section-title" style="text-align:center;margin-bottom:2rem;">Frequently Asked Questions</h2>
      <div style="display:flex;flex-direction:column;gap:0;">
        {[
          {
            q: 'Where does your stock ship from?',
            a: 'All orders dispatch from our EU warehouse. We do not ship from the UK. Your parcel moves entirely within the EU — from our warehouse to your address — with no customs clearance required.'
          },
          {
            q: 'Why does it matter that stock is inside the EU?',
            a: 'Since Brexit, UK-to-EU shipments are third-country imports subject to EU customs rules. This creates seizure risk, customs delays, and potential duty charges. EU-to-EU shipments have none of these issues — they move as standard domestic European parcels.'
          },
          {
            q: 'Which countries do you deliver to?',
            a: 'All EU member states plus Switzerland, Norway, and Iceland. Standard tracked delivery. Germany in 2–3 days, France 3–4 days, Netherlands 1–2 days. Full tracking on every order.'
          },
          {
            q: 'What purity are your peptides?',
            a: 'All compounds are supplied at >99% analytical purity, verified by HPLC. Certificates of Analysis with lot-specific data are available on request.'
          },
          {
            q: 'Do you offer Bac Water for reconstitution?',
            a: 'Yes. Bac Water (bacteriostatic water, 0.9% benzyl alcohol) is available in our catalogue and is the standard reconstitution solvent for all our lyophilised peptides.'
          },
        ].map(({ q, a }) => (
          <div class="faq-item" style="border-top:1px solid var(--border);padding:1.25rem 0;">
            <button class="faq-question" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;font-size:0.95rem;font-weight:600;color:var(--text);display:flex;justify-content:space-between;align-items:center;gap:1rem;">
              {q}
              <span class="faq-chevron" style="color:var(--accent);font-size:1.2rem;transition:transform 0.2s;flex-shrink:0;">﹀</span>
            </button>
            <div class="faq-answer" style="font-size:0.875rem;color:var(--text-muted);line-height:1.65;padding-top:0.75rem;display:none;">
              {a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  @media (max-width: 640px) {
    .grid-4 { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 400px) {
    .grid-4 { grid-template-columns: 1fr !important; }
  }
</style>
