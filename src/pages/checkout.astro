---
import Base from '../layouts/Base.astro';
import { products, ALL_VARIANTS } from '../lib/products';

export const prerender = false;

const variantId = Astro.url.searchParams.get('variant') ?? ALL_VARIANTS[0].id;
const cancelled = Astro.url.searchParams.get('cancelled') === '1';

// Find the pre-selected variant
const selectedVariant = ALL_VARIANTS.find((v) => v.id === variantId) ?? ALL_VARIANTS[0];
const selectedProduct = products.find((p) => p.variants.some((v) => v.id === selectedVariant.id));
---

<Base
  title="Secure Checkout — UK Peptides"
  description="Complete your research peptide order. Secure payment via Peptide-Pay. Visa, Mastercard, Apple Pay, Google Pay, Crypto."
  robots="noindex, nofollow"
>
  <section style="background:var(--bg-alt);min-height:90vh;padding:5rem 0;">
    <div class="container--narrow">

      <div style="margin-bottom:2rem;">
        <h1 style="font-size:1.75rem;margin-bottom:0.4rem;">Secure Checkout</h1>
        <p style="color:var(--text-muted);">100% secure payment via Peptide-Pay &mdash; Visa, Mastercard, Apple Pay, Google Pay, or Crypto.</p>
      </div>

      {cancelled && (
        <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:var(--radius-sm);padding:0.9rem 1.25rem;margin-bottom:1.5rem;color:#374151;font-size:0.9rem;">
          Payment cancelled. You can try again below &mdash; your selection has been kept.
        </div>
      )}

      <form id="checkoutForm" style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:2rem;box-shadow:var(--shadow);">

        <!-- Product & variant -->
        <div class="form-group" style="margin-bottom:1.25rem;">
          <label class="form-label" for="variantSelect">Product &amp; Quantity</label>
          <select
            id="variantSelect"
            name="variantId"
            class="form-select"
            required
            data-variants={JSON.stringify(ALL_VARIANTS.map((v) => ({ id: v.id, label: v.label, price: v.priceEur })))}
          >
            {products.map((product) => (
              <optgroup label={product.name}>
                {product.variants.map((v) => (
                  <option value={v.id} selected={v.id === selectedVariant.id} data-price={v.priceEur}>
                    {v.label} &mdash; &euro;{v.priceEur}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>

          <p id="priceDisplay" style="margin-top:0.6rem;font-family:var(--font-head);font-weight:700;font-size:1.4rem;color:var(--gold);">
            &euro;{selectedVariant.priceEur}
          </p>
        </div>

        <!-- Name row -->
        <div class="form-grid-2" style="margin-bottom:1.25rem;">
          <div class="form-group">
            <label class="form-label" for="firstName">First Name</label>
            <input id="firstName" name="firstName" type="text" class="form-input" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="lastName">Last Name</label>
            <input id="lastName" name="lastName" type="text" class="form-input" required autocomplete="family-name" />
          </div>
        </div>

        <!-- Email -->
        <div class="form-group" style="margin-bottom:1.25rem;">
          <label class="form-label" for="email">Email Address</label>
          <input id="email" name="email" type="email" class="form-input" required autocomplete="email" placeholder="your@email.com" />
          <p class="form-hint">Order confirmation will be sent here.</p>
        </div>

        <!-- Address -->
        <div class="form-group" style="margin-bottom:1.25rem;">
          <label class="form-label" for="address">Shipping Address</label>
          <input id="address" name="address" type="text" class="form-input" required autocomplete="street-address" />
        </div>

        <!-- Postal + City -->
        <div class="form-grid-postcode" style="margin-bottom:1.25rem;">
          <div class="form-group">
            <label class="form-label" for="postalCode">Postcode</label>
            <input id="postalCode" name="postalCode" type="text" class="form-input" required autocomplete="postal-code" />
          </div>
          <div class="form-group">
            <label class="form-label" for="city">City</label>
            <input id="city" name="city" type="text" class="form-input" required autocomplete="address-level2" />
          </div>
        </div>

        <!-- Country -->
        <div class="form-group" style="margin-bottom:1.75rem;">
          <label class="form-label" for="country">Country</label>
          <select id="country" name="country" class="form-select" required>
            <option value="GB" selected>United Kingdom</option>
            <option value="DE">Germany</option>
            <option value="FR">France</option>
            <option value="NL">Netherlands</option>
            <option value="BE">Belgium</option>
            <option value="ES">Spain</option>
            <option value="IT">Italy</option>
            <option value="PL">Poland</option>
            <option value="AT">Austria</option>
            <option value="SE">Sweden</option>
            <option value="DK">Denmark</option>
            <option value="NO">Norway</option>
            <option value="CH">Switzerland</option>
            <option value="IE">Ireland</option>
            <option value="PT">Portugal</option>
          </select>
        </div>

        <!-- Promo code -->
        <div id="promo-wrap" style="margin-bottom:1.25rem;border-top:1px solid var(--border);padding-top:1.25rem;">
          <button type="button" id="promo-toggle" style="font-size:0.82rem;color:var(--gold);background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:0.3rem;padding:0;">
            Have a promo code?
            <svg id="promo-arrow" style="width:12px;height:12px;transition:transform 0.2s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div id="promo-field" style="display:none;margin-top:0.6rem;display:none;gap:0.5rem;align-items:center;">
            <input id="promo-input" type="text" placeholder="Enter code" maxlength="20"
                   class="form-input" style="flex:1;text-transform:uppercase;letter-spacing:0.05em;" />
            <button type="button" id="promo-apply" class="btn btn-primary" style="white-space:nowrap;padding:0.5rem 1rem;">
              Apply
            </button>
          </div>
          <div id="promo-ok" style="display:none;margin-top:0.4rem;font-size:0.82rem;color:#15803d;font-weight:600;">
            ✓ REVIEW10 applied — 10% off
          </div>
          <div id="promo-err" style="display:none;margin-top:0.4rem;font-size:0.82rem;color:#b91c1c;">
            Invalid code
          </div>
        </div>

        <!-- Trust reassurance -->
        <div class="form-trust-grid" style="margin-bottom:1.75rem;text-align:center;">
          {[
            { icon: '&#128666;', line1: 'Tracked', line2: 'Shipping' },
            { icon: '&#128274;', line1: 'SSL', line2: '3D-Secure' },
            { icon: '&#128337;', line1: 'Fast', line2: 'Dispatch' },
            { icon: '&#128274;', line1: 'Discreet', line2: 'Packaging' },
          ].map((item) => (
            <div style="background:var(--bg-alt);border-radius:var(--radius-sm);padding:0.65rem 0.5rem;">
              <div style="font-size:1.2rem;margin-bottom:0.2rem;" set:html={item.icon}></div>
              <div style="font-size:0.72rem;font-weight:600;color:var(--text-muted);line-height:1.3;">{item.line1}<br/>{item.line2}</div>
            </div>
          ))}
        </div>

        <!-- Submit -->
        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
          Pay &euro;{selectedVariant.priceEur} &rarr;
        </button>

        <div id="formError" style="display:none;margin-top:1rem;background:#fef2f2;border:1px solid #fecaca;border-radius:var(--radius-sm);padding:0.75rem 1rem;color:#b91c1c;font-size:0.875rem;"></div>

        <p style="font-size:0.78rem;color:var(--text-faint);text-align:center;margin-top:0.75rem;">
          Clicking "Pay Securely" redirects you to our secure processor (Peptide-Pay).
          We accept Visa, Mastercard, Apple Pay, Google Pay, and crypto.
        </p>

        <!-- Co-primary: pay with Revolut / PayPal via Telegram -->
        <a
          href="https://t.me/ox_fr?text=Hello%2C%20I%27d%20like%20to%20pay%20with%20Revolut%20or%20PayPal%20for%20my%20UK%20Peptides%20order.%20Please%20send%20me%20a%20payment%20link."
          target="_blank"
          rel="noopener noreferrer"
          class="revpp-btn"
          style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.15rem;width:100%;box-sizing:border-box;margin-top:0.85rem;background:#ffffff;color:#18181b;border:2px solid #d4d4d8;border-radius:12px;padding:14px 16px;text-decoration:none;transition:border-color 0.15s,color 0.15s;"
        >
          <span style="font-size:15px;font-weight:700;line-height:1.2;">Pay with Revolut or PayPal</span>
          <span style="font-size:12px;color:#6b7280;font-weight:500;line-height:1.3;">Secure payment link via Telegram in 2 min</span>
        </a>

      </form>

      <!-- ── Support / payment-help card (clean, professional) ── -->
      <div style="margin-top:1.75rem;background:#ffffff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 1px 3px rgba(0,0,0,.06);padding:20px;text-align:center;">
        <div style="display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:8px;">
          <span class="support-dot" style="position:relative;display:inline-block;width:8px;height:8px;flex-shrink:0;">
            <span class="support-dot__ping" style="position:absolute;inset:0;border-radius:50%;background:#10b981;"></span>
            <span style="position:relative;display:block;width:8px;height:8px;border-radius:50%;background:#10b981;"></span>
          </span>
          <span style="font-size:11px;color:#6b7280;">Customer support 7/7 &middot; reply within minutes</span>
        </div>
        <p style="font-size:14px;font-weight:600;color:#18181b;margin:0 0 14px;line-height:1.4;">
          A question, or stuck at payment?
        </p>
        <a
          href="https://t.me/ox_fr?text=Hello%2C%20I%27m%20stuck%20at%20payment%20on%20UK%20Peptides.%20Please%20send%20me%20a%20Revolut%20or%20PayPal%20payment%20link."
          target="_blank"
          rel="noopener noreferrer"
          class="support-tg-btn"
          style="display:flex;align-items:center;justify-content:center;gap:0.6rem;width:100%;box-sizing:border-box;background:var(--accent);color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;border-radius:12px;padding:16px;transition:background 0.15s;"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#ffffff" style="flex-shrink:0;" aria-hidden="true"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71l-4.14-3.05-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
          Message us on Telegram
        </a>
        <p style="font-size:13px;color:#6b7280;line-height:1.55;margin:14px 0 0;">
          Prefer Revolut or PayPal? Send us your order details on Telegram and we&rsquo;ll reply with a payment link.
        </p>
      </div>

    </div>
  </section>

  <script is:inline>
    // Pre-warm serverless functions while the user fills the form.
    fetch('/api/warmup').catch(function(){});
    fetch('https://www.peptide-pay.com/api/v1/warmup').catch(function(){});

    (function() {
      var form = document.getElementById('checkoutForm');
      var btn = document.getElementById('submitBtn');
      var errorEl = document.getElementById('formError');
      var priceDisplay = document.getElementById('priceDisplay');
      var variantSelect = document.getElementById('variantSelect');

      if (!form) return;

      // Compute current total (respecting promo) as a display string, e.g. "€50"
      function currentTotalStr() {
        if (!variantSelect) return '';
        var opt = variantSelect.options[variantSelect.selectedIndex];
        var raw = opt ? parseFloat(opt.getAttribute('data-price') || '0') : 0;
        var val = appliedPromo ? (Math.round(raw * 0.9 * 100) / 100) : raw;
        return '€' + val.toFixed(0);
      }

      // Mirror the live total into the main pay button label.
      function updatePayButton() {
        if (!btn || btn.disabled) return;
        btn.innerHTML = 'Pay ' + currentTotalStr() + ' →';
      }

      // Update price display on variant change
      if (variantSelect && priceDisplay) {
        variantSelect.addEventListener('change', function() {
          var opt = variantSelect.options[variantSelect.selectedIndex];
          var price = opt ? opt.getAttribute('data-price') : null;
          if (price) {
            var discounted = appliedPromo ? (Math.round(parseFloat(price) * 0.9 * 100) / 100).toFixed(0) : price;
            priceDisplay.textContent = '€' + discounted;
          }
          updatePayButton();
        });
      }

      // Promo code
      var appliedPromo = '';
      var promoToggle = document.getElementById('promo-toggle');
      var promoField  = document.getElementById('promo-field');
      var promoArrow  = document.getElementById('promo-arrow');
      var promoInput  = document.getElementById('promo-input');
      var promoApply  = document.getElementById('promo-apply');
      var promoOk     = document.getElementById('promo-ok');
      var promoErr    = document.getElementById('promo-err');

      if (promoToggle && promoField) {
        promoToggle.addEventListener('click', function() {
          promoField.style.display = promoField.style.display === 'none' ? 'flex' : 'none';
          if (promoArrow) promoArrow.style.transform = promoField.style.display === 'flex' ? 'rotate(180deg)' : '';
        });
      }

      if (promoApply) {
        promoApply.addEventListener('click', function() {
          var code = (promoInput ? promoInput.value : '').trim().toUpperCase();
          if (code === 'REVIEW10') {
            appliedPromo = 'REVIEW10';
            if (promoOk) promoOk.style.display = 'block';
            if (promoErr) promoErr.style.display = 'none';
            // Update price display
            if (variantSelect && priceDisplay) {
              var opt = variantSelect.options[variantSelect.selectedIndex];
              var price = opt ? parseFloat(opt.getAttribute('data-price') || '0') : 0;
              priceDisplay.textContent = '€' + (Math.round(price * 0.9 * 100) / 100).toFixed(0);
            }
            updatePayButton();
          } else {
            appliedPromo = '';
            if (promoOk) promoOk.style.display = 'none';
            if (promoErr) promoErr.style.display = 'block';
          }
        });
      }

      // Sync button label with the initially-selected variant on load.
      updatePayButton();

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (!btn || !errorEl) return;

        errorEl.style.display = 'none';
        btn.disabled = true;
        btn.textContent = 'Processing…';

        var payload = {
          variantId: document.getElementById('variantSelect').value,
          email: document.getElementById('email').value,
          firstName: document.getElementById('firstName').value,
          lastName: document.getElementById('lastName').value,
          address: document.getElementById('address').value,
          postalCode: document.getElementById('postalCode').value,
          city: document.getElementById('city').value,
          country: document.getElementById('country').value,
        };
        if (appliedPromo) payload.promo = appliedPromo;

        try {
          var res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await res.json();
          if (!res.ok || !data.checkoutUrl) {
            throw new Error(data.error || 'Unable to start checkout');
          }
          window.location.href = data.checkoutUrl;
        } catch (err) {
          errorEl.textContent = (err && err.message) || 'An unexpected error occurred. Please try again in a few moments.';
          errorEl.style.display = 'block';
          btn.disabled = false;
          updatePayButton();
        }
      });
    })();
  </script>

  <style>
    .support-tg-btn:hover { background: var(--accent-hover) !important; }
    .support-dot__ping {
      animation: support-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes support-ping {
      0%   { transform: scale(1);   opacity: 0.65; }
      75%, 100% { transform: scale(2.4); opacity: 0; }
    }
    .revpp-btn:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      align-items: start;
    }
    .form-grid-postcode {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 1rem;
      align-items: start;
    }
    .form-trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
    @media (max-width: 560px) {
      .form-grid-2      { grid-template-columns: 1fr; }
      .form-grid-postcode { grid-template-columns: 1fr 1fr; }
      .form-trust-grid  { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</Base>
