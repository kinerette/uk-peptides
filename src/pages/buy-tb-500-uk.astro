---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductBySlug, products } from '../lib/products';
import { dualPrice } from '../lib/constants';

const product = getProductBySlug('tb-500');
if (!product) return Astro.redirect('/products');

const lowestVariant = product.variants.reduce((a, b) => a.priceEur < b.priceEur ? a : b);
const priceLabel = dualPrice(lowestVariant.priceEur);
const lastUpdated = 'June 2026';

const related = ['bpc-157', 'bacteriostatic-water', 'retatrutide']
  .map((s) => products.find((p) => p.slug === s))
  .filter(Boolean) as typeof products;

const canonical = 'https://uk-peptides.eu/buy-tb-500-uk';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'TB-500 — Research Peptide UK',
  description: 'TB-500 (Thymosin Beta-4 fragment) for UK research use. Lyophilised, >99% purity, EU warehouse, 3-5 day tracked UK delivery.',
  image: `https://uk-peptides.eu${product.image}`,
  brand: { '@type': 'Brand', name: 'UK Peptides' },
  offers: product.variants.map((v) => ({
    '@type': 'Offer',
    price: v.priceEur,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    name: v.label,
    url: `https://uk-peptides.eu/checkout?variant=${v.id}`,
    priceValidUntil: '2027-12-31',
  })),
  dateModified: '2026-06-27',
};

const faqs = [
  {
    q: 'Where can I buy TB-500 in the UK?',
    a: 'You can buy TB-500 for research use from UK Peptides (uk-peptides.eu). Stock is held in our EU warehouse and dispatched with 3-5 day tracked delivery to UK addresses. Supplied as lyophilised powder, >99% analytical purity, with Certificate of Analysis available on request.',
  },
  {
    q: 'Is TB-500 legal in the UK?',
    a: 'TB-500 is not a controlled substance under the UK Misuse of Drugs Act 1971. It is sold strictly as a Research Use Only (RUO) reagent for in vitro laboratory study. It is not approved as a medicine in the UK and must not be used for human or animal consumption.',
  },
  {
    q: 'How much does TB-500 cost in the UK?',
    a: `TB-500 pricing at UK Peptides starts from ${priceLabel} for a ${lowestVariant.quantity} lyophilised vial. Larger vials carry a lower price per mg. Prices are shown in EUR with an approximate GBP reference, with tracked UK delivery included.`,
  },
  {
    q: 'How is TB-500 shipped to the UK?',
    a: 'Orders are dispatched from our EU warehouse via tracked courier. Estimated transit time to UK addresses is 3-5 business days post-dispatch. Discreet packaging with no external mention of contents. A tracking link is emailed once your order ships.',
  },
  {
    q: 'How should TB-500 be stored?',
    a: 'Store lyophilised vials at -20°C, protected from light and moisture. Once reconstituted with bacteriostatic water, store at 2-8°C and use within 28 days. Lyophilised shelf life is 24 months in a sealed vial.',
  },
  {
    q: 'Do I receive a Certificate of Analysis (COA)?',
    a: 'A Certificate of Analysis is available on request for any batch. Email contact@uk-peptides.eu with your order number after dispatch and we will forward the lab report (HPLC, mass spec) for the lot you received.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://uk-peptides.eu/' },
    { '@type': 'ListItem', position: 2, name: 'Buy TB-500 UK', item: canonical },
  ],
};
---

<Base
  title="Buy TB-500 UK 2026 — EU Warehouse, Tracked Delivery"
  description="Buy TB-500 UK for research. Thymosin Beta-4 fragment for tissue regeneration. >99% purity, EU warehouse, 3-5 day tracked UK delivery, COA on request."
  canonical={canonical}
  schema={[productSchema, faqSchema, breadcrumbSchema]}
>

  <!-- Breadcrumb -->
  <div style="background:var(--bg-alt);border-bottom:1px solid var(--border);padding:0.75rem 0;">
    <div class="container">
      <nav aria-label="Breadcrumb" style="font-size:0.8rem;color:var(--text-muted);">
        <a href="/" style="color:var(--text-muted);text-decoration:none;">Home</a>
        <span style="margin:0 0.4rem;">/</span>
        <span style="color:var(--text);">Buy TB-500 UK</span>
      </nav>
    </div>
  </div>

  <!-- HERO -->
  <section style="background:var(--dark);padding:4.5rem 0 3.5rem;color:#fff;">
    <div class="container">
      <div style="display:grid;grid-template-columns:1.2fr 1fr;gap:3rem;align-items:center;">
        <div>
          <span style="display:inline-block;background:rgba(59,159,212,0.15);color:#3B9FD4;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.3rem 0.85rem;border-radius:999px;border:1px solid rgba(59,159,212,0.3);margin-bottom:1.25rem;">
            UK Stock · EU Warehouse · 3-5 Day Tracked
          </span>
          <h1 style="font-size:clamp(2rem,4.4vw,2.85rem);line-height:1.12;margin-bottom:1.1rem;color:#fff;">
            Buy TB-500 UK — <span style="color:#3B9FD4;">From {priceLabel}</span>
          </h1>
          <p style="color:rgba(255,255,255,0.7);font-size:1.05rem;line-height:1.65;margin-bottom:0.5rem;max-width:520px;">
            <strong style="color:#fff;">TB-500 is a synthetic Thymosin Beta-4 fragment studied for tissue regeneration and recovery.</strong>
          </p>
          <p style="color:rgba(255,255,255,0.7);font-size:1rem;line-height:1.65;margin-bottom:1.5rem;max-width:520px;">
            Supplied as lyophilised powder for UK laboratory research. &gt;99% analytical purity, dispatched from our EU warehouse with tracked UK delivery and no third-country customs declaration.
          </p>

          <ul style="list-style:none;padding:0;margin:0 0 2rem;display:grid;grid-template-columns:1fr 1fr;gap:0.55rem 1.25rem;">
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> &gt;99% HPLC purity</li>
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> EU warehouse, no customs risk</li>
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> 3-5 day UK tracked delivery</li>
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> Discreet packaging</li>
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> COA available on request</li>
            <li style="display:flex;align-items:center;gap:0.55rem;font-size:0.875rem;color:rgba(255,255,255,0.82);"><span style="color:#3B9FD4;">&#10003;</span> Lyophilised, 24-month shelf life</li>
          </ul>

          <div style="display:flex;gap:0.85rem;flex-wrap:wrap;">
            <a href={`/checkout?variant=${lowestVariant.id}`} class="btn btn-primary btn-lg">
              Order TB-500 — From {priceLabel} &rarr;
            </a>
            <a href="/products/tb-500" class="btn btn-outline" style="border-color:rgba(255,255,255,0.25);color:#fff;">
              Full Product Specs
            </a>
          </div>

          <p style="font-size:0.75rem;color:rgba(255,255,255,0.45);margin-top:1rem;">
            Research Use Only (RUO). Not for human consumption. Updated {lastUpdated}.
          </p>
        </div>

        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-xl);padding:2rem;display:flex;align-items:center;justify-content:center;min-height:340px;">
          <img
            src={product.image}
            alt="TB-500 vial — research grade UK"
            width="240"
            height="240"
            loading="eager"
            fetchpriority="high"
            style="max-width:100%;height:auto;filter:drop-shadow(0 16px 32px rgba(0,0,0,0.35));"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section style="background:var(--white);border-bottom:1px solid var(--border);padding:1.5rem 0;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.25rem;text-align:center;">
        <div><strong style="display:block;font-family:var(--font-head);color:var(--dark);">3-5 days</strong><span style="font-size:0.78rem;color:var(--text-muted);">UK tracked delivery</span></div>
        <div><strong style="display:block;font-family:var(--font-head);color:var(--dark);">&gt;99%</strong><span style="font-size:0.78rem;color:var(--text-muted);">HPLC analytical purity</span></div>
        <div><strong style="display:block;font-family:var(--font-head);color:var(--dark);">EU Stock</strong><span style="font-size:0.78rem;color:var(--text-muted);">No customs seizure risk</span></div>
        <div><strong style="display:block;font-family:var(--font-head);color:var(--dark);">COA</strong><span style="font-size:0.78rem;color:var(--text-muted);">Available on request</span></div>
      </div>
    </div>
  </section>

  <!-- PRICING TABLE -->
  <section style="padding:3.5rem 0;background:var(--bg);">
    <div class="container" style="max-width:880px;">
      <h2 style="font-size:1.6rem;margin-bottom:0.5rem;">TB-500 Pricing — UK</h2>
      <p style="color:var(--text-muted);margin-bottom:2rem;font-size:0.95rem;">
        Prices shown in EUR with an approximate GBP reference. EU warehouse stock, tracked UK delivery included.
      </p>

      <div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;">
        {product.variants.map((v, i) => (
          <div style={`display:grid;grid-template-columns:1.4fr 1fr auto;align-items:center;gap:1rem;padding:1.25rem 1.5rem;${i < product.variants.length - 1 ? 'border-bottom:1px solid var(--border);' : ''}`}>
            <div>
              <strong style="font-family:var(--font-head);font-size:1.05rem;color:var(--dark);">{v.label}</strong>
              <p style="font-size:0.8rem;color:var(--text-muted);margin-top:0.15rem;">{v.quantity} lyophilised vial</p>
            </div>
            <div>
              <strong style="font-family:var(--font-head);font-size:1.15rem;color:var(--dark);">{dualPrice(v.priceEur)}</strong>
            </div>
            <a href={`/checkout?variant=${v.id}`} class="btn btn-primary" style="white-space:nowrap;">Order &rarr;</a>
          </div>
        ))}
      </div>

      <p style="font-size:0.78rem;color:var(--text-muted);margin-top:1rem;text-align:center;">
        Secure checkout via Peptide-Pay &middot; Visa, Mastercard, Apple Pay, Google Pay, Crypto &middot; All prices include UK shipping
      </p>
    </div>
  </section>

  <!-- WHY UK PEPTIDES -->
  <section style="padding:3.5rem 0;background:var(--white);border-top:1px solid var(--border);">
    <div class="container" style="max-width:1040px;">
      <h2 style="font-size:1.6rem;margin-bottom:0.5rem;">Why UK Researchers Buy TB-500 From Us</h2>
      <p style="color:var(--text-muted);margin-bottom:2rem;font-size:0.95rem;max-width:680px;">
        For UK and EU researchers studying tissue regeneration, reliable supply matters as much as the compound. EU warehouse stock removes the post-Brexit customs lottery on inbound research chemicals.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;">
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">EU warehouse, no customs lottery</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Orders ship from inside the EU under standard postal routes, with no third-country import declaration that triggers a UK Border Force inspection.
          </p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">&gt;99% HPLC purity</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Every batch verified by HPLC and mass spectrometry. COA available on request for the specific lot number you receive.
          </p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">Lyophilised stability</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Supplied as lyophilised powder held at -20°C until dispatch, with a 24-month sealed shelf life. No cold chain needed for shipping.
          </p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">14-day right to cancel</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Full Consumer Contracts Regulations 2013 cooling-off period for UK buyers. Failed delivery is reshipped or refunded.
          </p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">Discreet packaging</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            No external mention of peptides, contents, or our brand on the outer parcel. Plain padded mailer addressed to the lab or individual.
          </p>
        </div>
        <div style="border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.5rem;background:var(--bg);">
          <strong style="display:block;font-family:var(--font-head);font-size:1.05rem;margin-bottom:0.55rem;color:var(--dark);">Documented research base</strong>
          <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6;">
            Thymosin Beta-4 has been studied since the 1960s, with the TB-500 fragment featured in cardiac, musculoskeletal and ocular repair models.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEARCH PROFILE -->
  <section style="padding:3.5rem 0;background:var(--bg);">
    <div class="container" style="max-width:880px;">
      <h2 style="font-size:1.6rem;margin-bottom:0.5rem;">TB-500 — The Research Profile</h2>
      <div class="prose" style="max-width:none;">
        <p>{product.description}</p>
        <h3 style="font-size:1.1rem;">Key research findings</h3>
        <ul>
          {product.keyFindings.map((f) => <li>{f}</li>)}
        </ul>
        {product.reconstitution && (
          <p><strong>Reconstitution:</strong> {product.reconstitution.solvent}, {product.reconstitution.volume}, working concentration {product.reconstitution.concentration}.</p>
        )}
        <p style="font-size:0.85rem;color:var(--text-muted);">{product.researchContext}</p>
      </div>

      <div style="margin-top:2rem;text-align:center;">
        <a href={`/checkout?variant=${lowestVariant.id}`} class="btn btn-primary btn-lg">
          Order TB-500 — From {priceLabel} &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:3.5rem 0;background:var(--white);border-top:1px solid var(--border);">
    <div class="container" style="max-width:760px;">
      <h2 style="font-size:1.6rem;margin-bottom:2rem;">Buying TB-500 in the UK — FAQ</h2>
      <div>
        {faqs.map((faq) => (
          <details style="border-bottom:1px solid var(--border);padding:1.1rem 0;">
            <summary style="cursor:pointer;font-weight:600;font-size:1rem;color:var(--dark);list-style:none;display:flex;justify-content:space-between;align-items:center;">
              <span>{faq.q}</span>
              <span style="color:var(--accent);font-size:1.2rem;">+</span>
            </summary>
            <p style="margin-top:0.8rem;color:var(--text-muted);font-size:0.92rem;line-height:1.65;">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section style="padding:3.5rem 0;background:var(--bg);border-top:1px solid var(--border);">
    <div class="container">
      <h2 style="font-size:1.4rem;margin-bottom:2rem;">Also Researched With TB-500</h2>
      <div class="grid-3">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- INTERNAL LINK BLOCK -->
  <section style="padding:2.5rem 0 4rem;background:var(--bg);">
    <div class="container" style="max-width:880px;">
      <div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-xl);padding:1.75rem;">
        <h3 style="font-size:1.05rem;margin-bottom:1rem;">Further reading for UK TB-500 researchers</h3>
        <ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0.65rem;">
          <li><a href="/blog/tb-500-europe-eu-warehouse" style="color:var(--accent);text-decoration:none;font-weight:600;">TB-500 Europe — EU Warehouse Stock</a></li>
          <li><a href="/blog/best-peptides-to-buy-uk-2026" style="color:var(--accent);text-decoration:none;font-weight:600;">Best Peptides to Buy UK 2026</a></li>
          <li><a href="/blog/where-to-buy-peptides-uk" style="color:var(--accent);text-decoration:none;font-weight:600;">Where to Buy Research Peptides UK</a></li>
          <li><a href="/blog/research-peptides-uk-complete-guide" style="color:var(--accent);text-decoration:none;font-weight:600;">Research Peptides UK — Technical Guide</a></li>
          <li><a href="/products/tb-500" style="color:var(--accent);text-decoration:none;font-weight:600;">Full TB-500 Product Page</a></li>
          <li><a href="/products" style="color:var(--accent);text-decoration:none;font-weight:600;">All Research Peptides</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
