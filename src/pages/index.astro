---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { featuredProducts } from '../lib/products';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const featuredPost = allPosts[0];
const recentPosts  = allPosts.slice(1, 3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UK Peptides',
  url: 'https://uk-peptides.eu',
  logo: 'https://uk-peptides.eu/images/products/retatrutide.webp',
  description: 'Research-grade peptides shipped across Europe. >99% purity. EU warehouse. Discreet packaging.',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'contact@uk-peptides.eu' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UK Peptides',
  url: 'https://uk-peptides.eu',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://uk-peptides.eu/products?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Peptides UK — Buy Research Peptides | UK Peptides"
  description="Premium research peptides UK — retatrutide, BPC-157, TB-500, GHK-Cu and more. >99% purity, EU warehouse, discreet shipping. The trusted source for research peptides in the UK."
  schema={[orgSchema, websiteSchema]}
>

  <!-- ═══════════════════════════════════════════
       HERO — PHARMA PREMIUM
  ═══════════════════════════════════════════ -->
  <section class="hero-section">
    <!-- Decorative radial glows -->
    <div class="hero-glow hero-glow--1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--2" aria-hidden="true"></div>

    <div class="container">
      <div class="hero-layout">

        <!-- LEFT: copy + CTA -->
        <div class="hero-copy">

          <!-- Trust pill -->
          <div class="hero-pill reveal">
            <span class="hero-pill__dot" aria-hidden="true"></span>
            EU Warehouse · >99% Purity · Delivery Across Europe
          </div>

          <h1 class="hero-h1 reveal">
            The UK's Trusted<br/>
            Source for <span class="hero-h1--accent">Research<br/>Peptides</span>
          </h1>

          <p class="hero-sub reveal">
            Lyophilised peptides supplied for legitimate scientific research.
            EU stock, discreet packaging, 3–5 day delivery across Europe.
          </p>

          <!-- Stats row -->
          <div class="hero-stats reveal">
            <div class="hero-stat">
              <strong>1,200+</strong>
              <span>Researchers</span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <strong>&gt;99%</strong>
              <span>Purity grade</span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <strong>10+</strong>
              <span>Compounds</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="hero-ctas reveal">
            <a href="/products" class="btn btn-primary btn-lg">
              Shop All Peptides &rarr;
            </a>
            <a href="/blog" class="btn btn-outline btn-lg">
              Research Guides
            </a>
          </div>

          <!-- Payment logos -->
          <div class="hero-pay reveal">
            <img src="/logos/visa.svg"              alt="Visa"        height="18" loading="eager" />
            <img src="/logos/mastercard-color.svg"  alt="Mastercard"  height="18" loading="eager" />
            <img src="/logos/apple-pay-color.svg"   alt="Apple Pay"   height="18" loading="eager" />
            <img src="/logos/google-pay-color.svg"  alt="Google Pay"  height="18" loading="eager" />
            <img src="/logos/sepa.svg"              alt="SEPA"        height="18" loading="eager" />
          </div>
          <p class="hero-pay-label">
            Secure payment via
            <img src="/logos/peptide-pay-logo.svg" alt="Peptide-Pay" height="10" style="display:inline;vertical-align:middle;margin-left:3px;opacity:0.55;" />
          </p>
        </div>

        <!-- RIGHT: featured vial -->
        <div class="hero-product reveal">
          <div class="hero-product__ring" aria-hidden="true"></div>
          <img
            src="/images/products/retatrutide.webp"
            alt="Retatrutide research peptide vial — UK Peptides"
            width="340"
            height="340"
            loading="eager"
            class="hero-product__img"
            onerror="this.style.display='none'"
          />
          <div class="hero-product__tag">
            <span class="badge badge-blue" style="font-size:0.7rem;">Most Popular</span>
            <strong>Retatrutide</strong>
            <span>From &euro;94</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       NUMBERS BAR
  ═══════════════════════════════════════════ -->
  <div class="numbers-bar">
    <div class="container">
      <div class="numbers-bar__grid">
        {[
          { n: '1,200+', l: 'Researchers across Europe' },
          { n: '>99%',   l: 'Analytical purity standard' },
          { n: '10+',    l: 'Research compounds' },
          { n: '3–5d',   l: 'Delivery across Europe' },
        ].map((s) => (
          <div class="numbers-bar__item reveal">
            <strong>{s.n}</strong>
            <span>{s.l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       TRUST BAR (icons)
  ═══════════════════════════════════════════ -->
  <div class="trust-bar">
    <div class="trust-bar__item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>&gt;99% Analytical Standard</span>
    </div>
    <div class="trust-bar__item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <span>Tracked Delivery Across Europe</span>
    </div>
    <div class="trust-bar__item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>SSL &amp; 3D-Secure Payment</span>
    </div>
    <div class="trust-bar__item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
      <span>EU Warehouse Stock</span>
    </div>
    <div class="trust-bar__item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
      <span>Lyophilised · Research Use Only</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       RETATRUTIDE SPOTLIGHT
  ═══════════════════════════════════════════ -->
  <section class="spotlight-section">
    <div class="container">
      <div class="spotlight-grid reveal">

        <!-- Left: stats card -->
        <div class="spotlight-card">
          <div class="spotlight-card__img-wrap">
            <img
              src="/images/products/retatrutide.webp"
              alt="Retatrutide vial — research grade UK"
              width="260"
              height="260"
              loading="lazy"
              style="max-width:100%;height:auto;display:block;margin:0 auto;"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="spotlight-card__facts">
            {[
              { stat: '−24.2%', label: 'mean body weight (NEJM 2023, 48 weeks)' },
              { stat: 'Triple', label: 'GLP-1 / GIP / Glucagon receptor agonist' },
              { stat: '>99%',  label: 'purity, EU warehouse, fast EU dispatch' },
            ].map((f) => (
              <div class="spotlight-fact">
                <strong>{f.stat}</strong>
                <span>{f.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: text -->
        <div class="spotlight-copy">
          <span class="section-label">Top Research Compound</span>
          <h2 style="margin-bottom:1rem;">
            Retatrutide UK &mdash;<br/>
            Triple GLP-1/GIP/<wbr/>Glucagon Agonist
          </h2>
          <p style="color:var(--text-muted);line-height:1.75;margin-bottom:1rem;">
            Retatrutide is the most powerful metabolic research peptide in Phase&nbsp;III trials.
            Published in the <em>New England Journal of Medicine</em> (2023), it demonstrated
            <strong>−24.2% mean body weight reduction</strong> at 48 weeks — the highest single-peptide
            efficacy signal ever recorded in clinical research.
          </p>
          <p style="color:var(--text-muted);line-height:1.75;margin-bottom:2rem;">
            As a <strong>triple agonist</strong> at GLP-1, GIP, and glucagon receptors,
            researchers gain access to mechanisms unavailable with dual-agonist compounds.
            EU warehouse stock ensures fast, reliable delivery across Europe.
          </p>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
            <a href="/products/retatrutide" class="btn btn-primary btn-lg">
              Buy Retatrutide UK &rarr;
            </a>
            <a href="/blog/retatrutide-uk-triple-receptor-guide" class="btn btn-outline btn-lg">
              Research Guide
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PRODUCTS
  ═══════════════════════════════════════════ -->
  <section class="section" style="background:var(--bg-alt);">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="section-label">Our Catalogue</span>
          <h2 class="section-title">Featured Research Peptides</h2>
        </div>
        <a href="/products" class="btn btn-outline hide-mobile">
          View All 10 &rarr;
        </a>
      </div>

      <div class="grid-3">
        {featuredProducts.map((product) => (
          <div class="reveal">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:2rem;" class="reveal hide-desktop">
        <a href="/products" class="btn btn-outline">View All 10 Products &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOG — RESEARCH INTELLIGENCE (featured)
  ═══════════════════════════════════════════ -->
  <section class="section blog-section">
    <div class="container">

      <div class="section-header reveal">
        <div>
          <span class="section-label">Research Intelligence</span>
          <h2 class="section-title">Latest from the Research Blog</h2>
        </div>
        <a href="/blog" class="btn btn-outline hide-mobile">All Articles &rarr;</a>
      </div>

      <!-- Featured post (large) -->
      {featuredPost && (
        <a href={`/blog/${featuredPost.slug}`} class="blog-featured reveal">
          <div class="blog-featured__img-wrap">
            {featuredPost.data.heroImage ? (
              <img
                src={featuredPost.data.heroImage}
                alt={featuredPost.data.title}
                width="680"
                height="400"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;"
                onerror="this.parentElement.style.background='var(--bg-alt)'"
              />
            ) : (
              <div class="blog-featured__img-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(59,159,212,0.4)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              </div>
            )}
          </div>
          <div class="blog-featured__body">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;flex-wrap:wrap;">
              {featuredPost.data.keyword && (
                <span class="badge badge-blue">{featuredPost.data.keyword}</span>
              )}
              <time datetime={featuredPost.data.publishedAt} style="font-size:0.78rem;color:var(--text-faint);">
                {new Date(featuredPost.data.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h3 class="blog-featured__title">{featuredPost.data.title}</h3>
            <p class="blog-featured__desc">{featuredPost.data.description}</p>
            <span class="blog-featured__cta">
              Read Article &rarr;
            </span>
          </div>
        </a>
      )}

      <!-- 2 smaller posts -->
      {recentPosts.length > 0 && (
        <div class="blog-grid-2 reveal">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="blog-mini">
              {post.data.heroImage && (
                <div class="blog-mini__img">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    width="400"
                    height="200"
                    loading="lazy"
                    style="width:100%;height:100%;object-fit:cover;"
                    onerror="this.parentElement.style.display='none'"
                  />
                </div>
              )}
              <div class="blog-mini__body">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
                  {post.data.keyword && <span class="badge badge-blue" style="font-size:0.7rem;">{post.data.keyword}</span>}
                  <time datetime={post.data.publishedAt} style="font-size:0.74rem;color:var(--text-faint);">
                    {new Date(post.data.publishedAt).toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>
                <h3 class="blog-mini__title">{post.data.title}</h3>
                <p class="blog-mini__desc">{post.data.description.length > 110 ? post.data.description.slice(0, 107) + '…' : post.data.description}</p>
                <span class="blog-mini__read">Read more &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div style="text-align:center;margin-top:2rem;" class="reveal hide-desktop">
        <a href="/blog" class="btn btn-outline">All Research Articles &rarr;</a>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHY CHOOSE US — 4 pillars
  ═══════════════════════════════════════════ -->
  <section class="why-section">
    <div class="container">
      <div style="text-align:center;margin-bottom:3rem;" class="reveal">
        <span class="section-label" style="color:rgba(255,255,255,0.5);">Why UK Peptides</span>
        <h2 class="section-title" style="color:#fff;">
          Why UK Researchers Choose Us
        </h2>
      </div>

      <div class="grid-4">
        {[
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD4" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>`,
            title: '>99% Purity',
            body: 'Analytical-grade lyophilised peptides. HPLC-tested every batch — no shortcuts.',
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD4" stroke-width="1.8" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
            title: 'EU Warehouse',
            body: 'Held within the EU for fast, reliable dispatch. No customs issues on European orders.',
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD4" stroke-width="1.8" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
            title: 'Tracked Shipping',
            body: 'Every order ships with full tracking. Discreet outer packaging — no identifying labels.',
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3B9FD4" stroke-width="1.8" stroke-linecap="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
            title: 'Research Compliant',
            body: 'Properly labelled RUO. Supplied exclusively for laboratory and scientific research.',
          },
        ].map((item) => (
          <div class="why-card reveal">
            <div class="why-card__icon" set:html={item.icon}></div>
            <h3 class="why-card__title">{item.title}</h3>
            <p class="why-card__body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FAQ TEASER
  ═══════════════════════════════════════════ -->
  <section class="section" style="background:var(--bg);">
    <div class="container" style="max-width:760px;">
      <div style="text-align:center;margin-bottom:2.5rem;" class="reveal">
        <span class="section-label">Legal FAQ</span>
        <h2 class="section-title" style="margin-bottom:0.5rem;">
          Are Peptides Legal in the UK?
        </h2>
        <p style="color:var(--text-muted);font-size:0.95rem;">
          Common questions from UK researchers about the legal status of research peptides.
        </p>
      </div>

      <div class="faq-list reveal">
        {[
          {
            q: 'Are research peptides legal in the UK?',
            a: 'Yes. Research-grade peptides are legal to purchase, possess, and use for legitimate scientific research in the UK. They are not controlled under the Misuse of Drugs Act 1971 or the Medicines Act 1968 when clearly labelled for research use only.',
          },
          {
            q: 'What does "Research Use Only" mean?',
            a: 'RUO designates that a product is intended exclusively for in vitro laboratory research and scientific study — not for diagnostic, therapeutic, or food/cosmetic purposes. This is the regulatory framework under which research peptides are sold in the UK.',
          },
          {
            q: 'Is retatrutide legal in the UK?',
            a: 'Yes. Retatrutide is not a controlled substance in the UK. It is not approved as a medicine, but as a research chemical it can be purchased and studied legally for scientific purposes.',
          },
        ].map((item) => (
          <div class="faq-item">
            <button class="faq-question" type="button">
              <span>{item.q}</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-answer">{item.a}</div>
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:2rem;" class="reveal">
        <a href="/faq" class="btn btn-outline">View Full FAQ &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FINAL CTA BANNER
  ═══════════════════════════════════════════ -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__inner reveal">
        <div>
          <h2 style="color:#fff;margin-bottom:0.5rem;">Ready to Start Your Research?</h2>
          <p style="color:rgba(255,255,255,0.65);font-size:0.95rem;">
            EU warehouse. Tracked delivery. >99% purity. Peptide-Pay secure checkout.
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
          <a href="/products" class="btn btn-white">Browse Products &rarr;</a>
          <a href="/checkout" class="btn btn-white-outline">Order Now</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ── HERO ── */
    .hero-section {
      position: relative;
      overflow: hidden;
      background: linear-gradient(155deg, #EBF5FC 0%, #F4F9FD 45%, #FAFAFA 100%);
      padding: 4.5rem 0 4rem;
    }
    .hero-glow {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-glow--1 {
      top: -80px; right: -60px;
      width: 520px; height: 520px;
      background: radial-gradient(circle, rgba(59,159,212,0.09) 0%, transparent 70%);
    }
    .hero-glow--2 {
      bottom: -120px; left: 20%;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(59,159,212,0.06) 0%, transparent 70%);
    }
    .hero-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(59,159,212,0.08);
      border: 1px solid rgba(59,159,212,0.2);
      border-radius: 999px;
      padding: 0.35rem 0.85rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.03em;
      margin-bottom: 1.5rem;
    }
    .hero-pill__dot {
      width: 6px; height: 6px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%,100% { opacity:1; transform:scale(1); }
      50%      { opacity:0.5; transform:scale(0.7); }
    }
    .hero-h1 {
      font-family: var(--font-head);
      font-weight: 700;
      font-size: clamp(2rem, 4vw, 3.25rem);
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: var(--dark);
      margin-bottom: 1.25rem;
    }
    .hero-h1--accent { color: var(--accent); }
    .hero-sub {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.7;
      max-width: 440px;
      margin-bottom: 2rem;
    }
    .hero-stats {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    .hero-stat strong {
      display: block;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 1.35rem;
      color: var(--accent);
      line-height: 1.1;
    }
    .hero-stat span {
      font-size: 0.72rem;
      color: var(--text-faint);
      font-weight: 500;
    }
    .hero-stat-divider {
      width: 1px;
      height: 36px;
      background: var(--border);
      flex-shrink: 0;
    }
    .hero-ctas {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1.75rem;
    }
    .hero-pay {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
      opacity: 0.75;
      margin-bottom: 0.35rem;
    }
    .hero-pay img { height: 18px; width: auto; }
    .hero-pay-label {
      font-size: 0.7rem;
      color: var(--text-faint);
    }

    /* Hero product */
    .hero-product {
      display: flex;
