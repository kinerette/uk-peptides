---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { featuredProducts, products } from '../lib/products';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const featuredPost = allPosts[0];
const recentPosts  = allPosts.slice(1, 3);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UK Peptides',
  url: 'https://uk-peptides.eu',
  logo: 'https://uk-peptides.eu/images/products/retatrutide.webp',
  description: 'Research-grade peptides shipped across Europe. >99% purity. EU warehouse. Discreet packaging.',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'contact@uk-peptides.eu' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UK Peptides',
  url: 'https://uk-peptides.eu',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://uk-peptides.eu/products?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Peptides UK — Buy Research Peptides | UK Peptides"
  description="Premium research peptides UK — retatrutide, BPC-157, TB-500, GHK-Cu and more. >99% purity, EU warehouse, discreet shipping. The trusted source for research peptides in the UK."
  schema={[orgSchema, websiteSchema]}
>

  <!-- ═══════════════════════════════════════════
       HERO — PHARMA PREMIUM
  ═══════════════════════════════════════════ -->
  <section class="hero-section">
    <!-- Full-bleed background image -->
    <img
      src="/images/hero-retatrutide.webp"
      alt=""
      aria-hidden="true"
      class="hero-bg-img"
      loading="eager"
    />
    <!-- Dark gradient overlay so text stays readable -->
    <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container" style="position:relative;z-index:1;">
    <div class="hero-layout">

      <!-- LEFT: copy -->
      <div class="hero-copy">
        <h1 class="hero-h1 reveal">
          Research Peptides<br/>
          <span class="hero-h1--accent">Shipped from Europe.</span><br/>
          <span class="hero-h1--sub">No Customs. No Seizures.</span>
        </h1>
        <p class="hero-sub reveal">
          Pharmaceutical-grade lyophilised peptides held in EU stock.
          Zero customs risk for European orders — 3–5 day tracked delivery across the EU &amp; UK.
        </p>

        <div class="hero-trust-pills reveal">
          <span class="trust-pill"><span class="trust-pill__check">✓</span> EU Warehouse</span>
          <span class="trust-pill"><span class="trust-pill__check">✓</span> No Customs Seizures</span>
          <span class="trust-pill"><span class="trust-pill__check">✓</span> CoA Available</span>
          <span class="trust-pill"><span class="trust-pill__check">✓</span> Full Tracking</span>
        </div>

        <div class="hero-search reveal">
          <form action="/products" method="get" class="hero-search-form">
            <input
              type="text"
              name="q"
              placeholder="Search: BPC-157, Retatrutide, NAD+..."
              class="hero-search-input"
              autocomplete="off"
            />
            <button type="submit" class="hero-search-btn" aria-label="Search">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
          </form>
        </div>

        <div class="hero-ctas reveal">
          <a href="/products" class="btn btn-hero-cta btn-lg">Shop All Peptides &rarr;</a>
        </div>

        <div class="hero-social-proof reveal">
          <span class="hero-stars" aria-hidden="true">★★★★★</span>
          <span class="hero-reviews">Trusted by 2,400+ researchers &nbsp;&middot;&nbsp; 4.9/5 &nbsp;&middot;&nbsp; <span style="color:#86EFAC;">Verified Reviews</span></span>
        </div>

        <div class="hero-pay reveal">
          <img src="/logos/visa.svg"             alt="Visa"       height="18" loading="eager" />
          <img src="/logos/mastercard-color.svg" alt="Mastercard" height="18" loading="eager" />
          <img src="/logos/apple-pay-color.svg"  alt="Apple Pay"  height="18" loading="eager" />
          <img src="/logos/google-pay-color.svg" alt="Google Pay" height="18" loading="eager" />
          <img src="/logos/sepa.svg"             alt="SEPA"       height="18" loading="eager" />
        </div>
        <p class="hero-pay-label">Secure payment via Peptide-Pay</p>
      </div>

    </div>
  </div>
</section>

  <!-- ═══════════════════════════════════════════
       CATALOGUE CAROUSEL — tight below hero
  ═══════════════════════════════════════════ -->
  <section class="carousel-section">
    <div class="carousel-label-bar">
      <span class="section-label">Our Catalogue</span>
      <span class="carousel-hint">{products.length} compounds &middot; drag to explore</span>
    </div>
    <div class="carousel-outer">
      <div class="carousel-fade carousel-fade--l" aria-hidden="true"></div>
      <div class="carousel-fade carousel-fade--r" aria-hidden="true"></div>
      <div
        id="carouselTrack"
        class="carousel-track"
        style="touch-action: pan-y;"
        data-products={JSON.stringify(products.map(p => ({
          slug: p.slug,
          name: p.name,
          qty: p.variants[0].quantity,
          price: Math.min(...p.variants.map(v => v.priceEur)),
          image: p.image,
        })))}
      >
        {products.map((product, idx) => (
          <div class="ci" data-slug={product.slug}>
            <a href={`/products/${product.slug}`} draggable="false" class="ci__link">
              <img
                src={product.image}
                alt={product.name}
                class="ci__img"
                loading={idx < 5 ? 'eager' : 'lazy'}
                draggable="false"
              />
            </a>
            <div class="ci__lbl">
              <span class="ci__name">{product.name}</span>
              <span class="ci__qty">{product.variants[0].quantity}</span>
              <span class="ci__price">&euro;{Math.min(...product.variants.map(v => v.priceEur))}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="carousel-cta">
      <a href="/products" class="btn btn-primary">Browse All Research Peptides &rarr;</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHY EU — COMPARISON TABLE
  ═══════════════════════════════════════════ -->
  <section class="compare-section">
    <div class="container">
      <div class="compare-header reveal">
        <span class="section-label" style="color:rgba(255,255,255,0.45);">Why It Matters</span>
        <h2 class="compare-title">Why sourcing from <em>inside</em> the EU changes everything</h2>
        <p class="compare-sub">Most peptide suppliers ship from outside Europe. Here is what that means for your order.</p>
      </div>

      <div class="compare-grid reveal">

        <!-- LEFT: others -->
        <div class="compare-card compare-card--bad">
          <div class="compare-card__header">
            <span class="compare-card__icon">✕</span>
            <span class="compare-card__label">Other suppliers</span>
            <span class="compare-card__origin">Ships from UK / USA / China</span>
          </div>
          <ul class="compare-list">
            <li><span class="ci-x">✕</span> Ships outside the EU — high customs seizure risk</li>
            <li><span class="ci-x">✕</span> Packages regularly stopped at EU/FR border</li>
            <li><span class="ci-x">✕</span> 3–6 weeks delivery, no guarantee of arrival</li>
            <li><span class="ci-x">✕</span> No parcel tracking once it crosses the border</li>
            <li><span class="ci-x">✕</span> Cold chain uncertain — degraded product risk</li>
            <li><span class="ci-x">✕</span> No CoA, no lot traceability</li>
          </ul>
        </div>

        <!-- DIVIDER -->
        <div class="compare-vs" aria-hidden="true">VS</div>

        <!-- RIGHT: us -->
        <div class="compare-card compare-card--good">
          <div class="compare-card__header">
            <span class="compare-card__icon compare-card__icon--good">✓</span>
            <span class="compare-card__label">UK Peptides</span>
            <span class="compare-card__origin compare-card__origin--good">EU Warehouse · Ships within Europe</span>
          </div>
          <ul class="compare-list compare-list--good">
            <li><span class="ci-ok">✓</span> <strong>Zero customs risk</strong> — EU to EU, no border issues</li>
            <li><span class="ci-ok">✓</span> No seizures, no fines, no surprises</li>
            <li><span class="ci-ok">✓</span> 3–5 day tracked delivery across EU &amp; UK</li>
            <li><span class="ci-ok">✓</span> Full tracking from dispatch to doorstep</li>
            <li><span class="ci-ok">✓</span> Cold-chain maintained, lyophilised &amp; sealed</li>
            <li><span class="ci-ok">✓</span> CoA available · &gt;99% purity every batch</li>
          </ul>
          <a href="/products" class="compare-cta">Shop EU Stock &rarr;</a>
        </div>

      </div>
    </div>
  </section>

  <script>
    import gsap from 'gsap';

    const track = document.getElementById('carouselTrack') as HTMLElement | null;
    if (!track) throw new Error('No carouselTrack');

    interface PData { slug: string; name: string; qty: string; price: number; image: string; }
    const PRODUCTS: PData[] = JSON.parse((track as any).dataset.products);
    const N = PRODUCTS.length;
    const CID = Math.max(0, PRODUCTS.findIndex((p: PData) => p.slug === 'retatrutide'));
    const SCALE = 1.1;
    const LIFT = -10;

    function getStep() {
      const vw = window.innerWidth;
      if (vw >= 1024) return 180;
      if (vw >= 640) return 140;
      return 95;
    }
    function getVisRange() {
      const s = getStep();
      return Math.ceil(window.innerWidth / s / 2) + 2;
    }
    function itemPos(i: number, off: number, st: number) {
      const total = N * st;
      let p = ((i * st - off) % total + total) % total;
      if (p > total / 2) p -= total;
      return p;
    }
    function clampOff(off: number, st: number) {
      const total = N * st;
      return ((off % total) + total) % total;
    }

    const itemEls = Array.from(track.querySelectorAll('.ci')) as HTMLElement[];
    const lblEls  = itemEls.map(el => el.querySelector('.ci__lbl') as HTMLElement | null);

    let step = getStep();
    let offset = CID * step;
    let visRange = getVisRange();
    let lastCenter = -1;
    let animating = false;
    let mounted = true;
    let done = false;
    let mTween: any = null;
    let aTween: any = null;
    let resumeT: any = null;
    let wasDrag = false;
    let rafId = 0;
    let drag: any = null;

    function setLayout() {
      track.style.height = (step >= 140 ? 320 : 240) + 'px';
      itemEls.forEach(el => {
        el.style.width = step + 'px';
        el.style.marginLeft = (-step / 2) + 'px';
      });
    }
    setLayout();

    function applyPos(off: number, anim: boolean, dur = 0.5) {
      const centerF = ((off / step) % N + N) % N;
      const nc = Math.round(centerF) % N;
      const cc = nc !== lastCenter;
      for (let d = -visRange; d <= visRange; d++) {
        const i = ((nc + d) % N + N) % N;
        const el = itemEls[i];
        if (!el) continue;
        const pos = itemPos(i, off, step);
        const dist = Math.abs(pos) / step;
        const ct = Math.max(0, 1 - dist);
        const sc = 1 + (SCALE - 1) * ct;
        const y = LIFT * ct;
        const op = dist <= 1 ? 1 : Math.max(0.08, 1 - (dist - 1) * (0.92 / (visRange - 1)));
        if (anim) {
          gsap.to(el, { x: pos, scale: sc, y, opacity: op, duration: dur, ease: 'power3.out', force3D: true, overwrite: 'auto' });
        } else {
          el.style.transform = `translate3d(${pos}px,${y}px,0) scale(${sc})`;
          el.style.opacity = String(op);
        }
        if (cc) (el.style as any).zIndex = String(Math.round((10 - dist) * 10));
        const lb = lblEls[i];
        if (lb) {
          const lo = d === 0 && ct > 0.5 ? Math.min(1, (ct - 0.5) * 3) : 0;
          lb.style.opacity = String(lo);
          lb.style.transform = `translate3d(0,${(1 - lo) * 4}px,0)`;
        }
      }
      if (cc) {
        const prev = lastCenter; lastCenter = nc;
        if (prev >= 0) {
          for (let d = -(visRange + 1); d <= visRange + 1; d++) {
            const i = ((prev + d) % N + N) % N;
            let rel = ((i - nc) % N + N) % N;
            if (rel > N / 2) rel = N - rel;
            if (rel <= visRange) continue;
            const el = itemEls[i];
            if (el) el.style.opacity = '0';
          }
          const ol = lblEls[prev];
          if (ol) ol.style.opacity = '0';
        }
      }
    }

    function killM() { if (mTween) { mTween.kill(); mTween = null; } animating = false; }
    function killA() { if (aTween) { aTween.kill(); aTween = null; } if (resumeT !== null) { clearTimeout(resumeT); resumeT = null; } }
    function snap() {
      const s = Math.round(offset / step) * step;
      if (Math.abs(offset - s) > 0.5) { offset = clampOff(s, step); applyPos(offset, false); }
    }
    function schedA(d = 3000) {
      if (resumeT !== null) { clearTimeout(resumeT); resumeT = null; }
      if (mounted) resumeT = setTimeout(autoNext, d);
    }

    function autoNext() {
      if (!done || !mounted || drag) return;
      if (animating && !mTween && !aTween) animating = false;
      if (animating) return;
      const base = clampOff(Math.round(offset / step) * step, step);
      offset = base;
      const target = base + step;
      const px = { val: base };
      animating = true;
      aTween = gsap.to(px, {
        val: target, duration: 0.5, ease: 'power2.inOut',
        onUpdate: () => { offset = px.val; applyPos(px.val, false); },
        onComplete: () => { offset = clampOff(target, step); aTween = null; animating = false; snap(); if (mounted) resumeT = setTimeout(autoNext, 900); },
      });
    }

    function goTo(idx: number) {
      if (!done) return;
      killM(); killA();
      const total = N * step;
      let diff = idx * step - offset;
      diff = ((diff % total) + total + total / 2) % total - total / 2;
      const dest = offset + diff;
      const px = { val: offset };
      animating = true;
      mTween = gsap.to(px, {
        val: dest, duration: Math.min(0.8, 0.3 + Math.abs(Math.round(diff / step)) * 0.08), ease: 'power3.out',
        onUpdate: () => { offset = px.val; applyPos(px.val, false); },
        onComplete: () => { offset = clampOff(dest, step); mTween = null; animating = false; snap(); schedA(4000); },
      });
    }

    function startDrag(cx: number, cy: number, isMouse: boolean) {
      if (isMouse) { killM(); killA(); }
      drag = { sx: cx, sy: cy, so: offset, px: cx, pt: Date.now(), samples: [{ x: cx, t: Date.now() }], dragging: false, dir: null, isMouse };
    }
    function moveDrag(cx: number, cy: number, prevent: () => void) {
      if (!drag) return;
      const dx = cx - drag.sx, dy = cy - drag.sy;
      if (!drag.dir) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        drag.dir = Math.abs(dx) > Math.abs(dy) * 1.2 ? 'h' : 'v';
        if (drag.dir === 'h') { killM(); killA(); drag.so = offset; drag.sx = cx; track.style.touchAction = 'none'; }
      }
      if (drag.dir === 'v') return;
      if (drag.dir === 'h' || drag.isMouse) {
        prevent(); drag.dragging = true;
        drag.px = cx; drag.pt = Date.now();
        drag.samples.push({ x: cx, t: Date.now() });
        if (drag.samples.length > 6) drag.samples.shift();
        const no = drag.so - (cx - drag.sx); offset = no;
        cancelAnimationFrame(rafId); rafId = requestAnimationFrame(() => applyPos(no, false));
      }
    }
    function endDrag(cx: number) {
      if (!drag) return;
      const et = Date.now(); const wasH = drag.dir === 'h' || drag.isMouse;
      const { dragging, samples } = drag; drag = null;
      track.style.touchAction = 'pan-y';
      if (!wasH || !dragging) { wasDrag = false; return; }
      wasDrag = true; samples.push({ x: cx, t: et });
      let vel = 0;
      const rec = samples.filter((p: any) => p.t >= et - 120);
      if (rec.length >= 2) { const f = rec[0], l = rec[rec.length - 1]; const dt = l.t - f.t; if (dt > 10) vel = -(l.x - f.x) / dt; }
      const proj = offset + vel * 600;
      const snapped = Math.round(proj / step) * step;
      const dist = Math.abs(snapped - offset); const ni = dist / step;
      const dur = ni < 0.3 ? 0.25 : Math.min(2.0, Math.max(0.3, ni * 0.15));
      const target = ni < 0.3 ? Math.round(offset / step) * step : snapped;
      const px = { val: offset }; animating = true;
      mTween = gsap.to(px, {
        val: target, duration: dur, ease: 'power2.out',
        onUpdate: () => { offset = px.val; applyPos(px.val, false); },
        onComplete: () => { offset = clampOff(target, step); mTween = null; animating = false; schedA(3000); },
      });
    }

    track.addEventListener('touchstart', (e: TouchEvent) => startDrag(e.touches[0].clientX, e.touches[0].clientY, false), { passive: true });
    track.addEventListener('touchmove', (e: TouchEvent) => moveDrag(e.touches[0].clientX, e.touches[0].clientY, () => e.preventDefault()), { passive: false } as any);
    track.addEventListener('touchend', (e: TouchEvent) => endDrag(e.changedTouches[0].clientX));
    track.addEventListener('touchcancel', () => {
      if (!drag) return;
      const wasH = drag.dragging && drag.dir === 'h'; drag = null; track.style.touchAction = 'pan-y';
      if (wasH) { const s = Math.round(offset / step) * step; const px = { val: offset }; animating = true; mTween = gsap.to(px, { val: s, duration: 0.25, ease: 'power2.out', onUpdate: () => { offset = px.val; applyPos(px.val, false); }, onComplete: () => { offset = clampOff(s, step); mTween = null; animating = false; schedA(3000); } }); }
    });
    track.addEventListener('mousedown', (e: MouseEvent) => { e.preventDefault(); startDrag(e.clientX, e.clientY, true); });
    window.addEventListener('mousemove', (e: MouseEvent) => { if (drag?.isMouse) moveDrag(e.clientX, e.clientY, () => e.preventDefault()); });
    window.addEventListener('mouseup', (e: MouseEvent) => { if (drag?.isMouse) endDrag(e.clientX); });
    track.addEventListener('click', (e: MouseEvent) => {
      if (wasDrag) { e.preventDefault(); e.stopPropagation(); wasDrag = false; return; }
      const link = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      const href = link.getAttribute('href') || '';
      if (!href.startsWith('/products/')) return;
      const slug = href.replace('/products/', '');
      const ci = PRODUCTS.findIndex((p: PData) => p.slug === slug);
      if (ci === -1) return;
      const cc = Math.round(((offset / step) % N + N) % N) % N;
      if (ci !== cc) { e.preventDefault(); e.stopPropagation(); goTo(ci); }
    }, true);

    applyPos(offset, false); done = true; schedA(300);

    const hb = setInterval(() => {
      if (!mounted || !done || document.hidden || drag || animating) return;
      if (!aTween && resumeT === null && !mTween) schedA(1000);
    }, 5000);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { killA(); killM(); }
      else if (done && mounted) { snap(); schedA(2000); }
    });

    let rTimer: any = null;
    window.addEventListener('resize', () => {
      if (rTimer) clearTimeout(rTimer);
      rTimer = setTimeout(() => {
        const ns = getStep(); visRange = getVisRange();
        if (ns !== step && done) {
          killM(); killA();
          const ci = Math.round(offset / step); step = ns; offset = ci * ns;
          setLayout(); applyPos(offset, true, 0.3); schedA(3000);
        }
      }, 150);
    }, { passive: true });
  </script>

  <!-- ═══════════════════════════════════════════
       PRODUCTS
  ═══════════════════════════════════════════ -->
  <section class="section" style="background:var(--bg-alt);">
    <div class="container">
      <div class="section-header reveal">
        <div>
          <span class="section-label">Our Catalogue</span>
          <h2 class="section-title">Featured Research Peptides</h2>
        </div>
        <a href="/products" class="btn btn-outline hide-mobile">
          View All 10 &rarr;
        </a>
      </div>

      <div class="grid-3">
        {featuredProducts.map((product) => (
          <div class="reveal">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:2rem;" class="reveal hide-desktop">
        <a href="/products" class="btn btn-outline">View All 10 Products &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       BLOG — RESEARCH INTELLIGENCE (featured)
  ═══════════════════════════════════════════ -->
  <section class="section blog-section">
    <div class="container">

      <div class="section-header reveal">
        <div>
          <span class="section-label">Research Intelligence</span>
          <h2 class="section-title">Latest from the Research Blog</h2>
        </div>
        <a href="/blog" class="btn btn-outline hide-mobile">All Articles &rarr;</a>
      </div>

      <!-- Featured post (large) -->
      {featuredPost && (
        <a href={`/blog/${featuredPost.slug}`} class="blog-featured reveal">
          <div class="blog-featured__img-wrap">
            {featuredPost.data.heroImage ? (
              <img
                src={featuredPost.data.heroImage}
                alt={featuredPost.data.title}
                width="680"
                height="400"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;"
                onerror="this.parentElement.style.background='var(--bg-alt)'"
              />
            ) : (
              <div class="blog-featured__img-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(59,159,212,0.4)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              </div>
            )}
          </div>
          <div class="blog-featured__body">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;flex-wrap:wrap;">
              {featuredPost.data.keyword && (
                <span class="badge badge-blue">{featuredPost.data.keyword}</span>
              )}
              <time datetime={featuredPost.data.publishedAt} style="font-size:0.78rem;color:var(--text-faint);">
                {new Date(featuredPost.data.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h3 class="blog-featured__title">{featuredPost.data.title}</h3>
            <p class="blog-featured__desc">{featuredPost.data.description}</p>
            <span class="blog-featured__cta">
              Read Article &rarr;
            </span>
          </div>
        </a>
      )}

      <!-- 2 smaller posts -->
      {recentPosts.length > 0 && (
        <div class="blog-grid-2 reveal">
          {recentPosts.map((post) => (
