---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GeoPopup from '../components/GeoPopup.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  robots?: string;
  pageType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/products/retatrutide.webp',
  schema,
  robots = 'index, follow, max-image-preview:large',
  pageType = 'website',
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={robots} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={pageType} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:site_name" content="UK Peptides" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

  <!-- Fonts: Space Grotesk + Inter — self-hosted via @fontsource (was Google Fonts
       CDN which triggered the Safari iOS 'Réduire les protections' privacy warning). -->
  {/* Google Fonts preconnects removed intentionally — no more third-party font fetch. */}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Schema.org -->
  {schemaArray.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <slot name="head" />
</head>
<body>
  <!-- Research gate — declared as a <template> so its copy is OUT of the
       crawled HTML body. Googlebot used to pick the gate paragraph as the
       SERP snippet ("This site presents research reagents…") instead of
       actual page content. The JS below clones the template only client-side. -->
  <template id="researchGateTpl">
    <div id="researchGate" class="age-gate-overlay" role="dialog" aria-modal="true" aria-labelledby="gateTitle" style="display:flex;">
      <div class="age-gate-card">
        <div class="age-gate-card__header">
          <h2 id="gateTitle">Restricted Access &mdash; Research Only</h2>
        </div>
        <div class="age-gate-card__body">
          <p>This site presents <strong>research reagents intended exclusively for in vitro laboratory use</strong>. By accessing the content, you confirm the following:</p>
          <ul>
            <li>You are <strong>18 years of age or older</strong>.</li>
            <li>You are a <strong>researcher, laboratory professional, or purchasing for scientific research purposes</strong>.</li>
            <li>You understand that these products <strong>are not medicines</strong> and are not intended for human or animal consumption.</li>
            <li>You accept the <a href="/legal/terms" target="_blank">Terms of Use</a> and <a href="/legal/privacy" target="_blank">Privacy Policy</a>.</li>
          </ul>
          <div class="age-gate-card__actions">
            <button id="researchGateDecline" type="button" class="age-gate-card__btn age-gate-card__btn--decline">
              No, leave
            </button>
            <button id="researchGateBtn" type="button" class="age-gate-card__btn age-gate-card__btn--accept">
              Yes, I confirm
            </button>
          </div>
          <p class="age-gate-card__footnote">Not for human use &middot; Research reagent only</p>
        </div>
      </div>
    </div>
  </template>

  <Header />

  <main style="flex: 1;">
    <slot />
  </main>

  <Footer />
  <GeoPopup />

  <!-- Sticky mobile CTA -->
  <div class="sticky-cta" id="stickyCta">
    <div class="sticky-cta__info">
      <span class="sticky-cta__name">Research Peptides · EU Warehouse</span>
      <span class="sticky-cta__price">10+ compounds · >99% purity</span>
    </div>
    <a href="/products" class="btn btn-primary btn-sm">Browse</a>
  </div>

  <script is:inline>
    // Research gate — clone the <template> into the DOM only when needed,
    // so Googlebot never sees the gate copy in the crawled HTML.
    (function () {
      var KEY = 'ukpep_research_confirmed';
      var tpl = document.getElementById('researchGateTpl');
      if (!tpl) return;

      try {
        var params = new URLSearchParams(location.search);
        if (params.get('gate') === 'skip') localStorage.setItem(KEY, '1');
      } catch (e) {}

      if (localStorage.getItem(KEY) === '1') {
        // Already confirmed — gate stays out, rest of the page boots normally.
        return;
      }

      // Clone template content into the body and wire the buttons
      var fragment = tpl.content.cloneNode(true);
      document.body.appendChild(fragment);
      var gate = document.getElementById('researchGate');
      var btn = document.getElementById('researchGateBtn');
      var decline = document.getElementById('researchGateDecline');
      if (!gate) return;
      document.body.style.overflow = 'hidden';
      btn && btn.addEventListener('click', function () {
        localStorage.setItem(KEY, '1');
        gate.remove();
        document.body.style.overflow = '';
      });
      decline && decline.addEventListener('click', function () {
        window.location.href = 'https://www.google.co.uk';
      });
    })();

    // Site UI bootstrap — runs unconditionally so post-gate visitors still
    // get scroll-reveal, sticky CTA, mobile menu, and FAQ accordion.
    (function () {
      // Mobile menu toggle
      var menuBtn = document.getElementById('menuBtn');
      var mobilePanel = document.getElementById('mobilePanel');
      if (menuBtn && mobilePanel) {
        menuBtn.addEventListener('click', function () {
          var isOpen = mobilePanel.style.display !== 'none';
          mobilePanel.style.display = isOpen ? 'none' : 'flex';
        });
      }

      // Sticky CTA
      var stickyCta = document.getElementById('stickyCta');
      if (stickyCta) {
        window.addEventListener('scroll', function () {
          stickyCta.classList.toggle('visible', window.scrollY > 500);
        }, { passive: true });
      }

      // Scroll reveal
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

      document.querySelectorAll('.reveal').forEach(function (el) {
        observer.observe(el);
      });

      // FAQ accordion
      document.querySelectorAll('.faq-question').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.faq-item');
          if (!item) return;
          var isOpen = item.classList.contains('open');
          document.querySelectorAll('.faq-item.open').forEach(function (i) {
            i.classList.remove('open');
          });
          if (!isOpen) item.classList.add('open');
        });
      });
    })();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
