---
import type { Product } from '../lib/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lowestPrice = Math.min(...product.variants.map((v) => v.priceEur));
const highestPrice = Math.max(...product.variants.map((v) => v.priceEur));

const categoryColour: Record<string, string> = {
  'Weight Management': 'badge-blue',
  'Recovery & Repair': 'badge-green',
  'Cognition': 'badge-gold',
  'Longevity': 'badge-dark',
  'Skin & Hair': 'badge-gold',
  'Solvent': 'badge-dark',
};
const badgeClass = categoryColour[product.category] ?? 'badge-blue';
---

<article class="card" style="display:flex;flex-direction:column;">
  <a href={`/products/${product.slug}`} style="text-decoration:none;color:inherit;display:block;overflow:hidden;">
    <div style="background:var(--bg-alt);height:220px;display:flex;align-items:center;justify-content:center;padding:1.5rem;position:relative;overflow:hidden;">
      <img
        src={product.image}
        alt={`${product.name} vial — research grade`}
        width="160"
        height="160"
        loading="lazy"
        style="object-fit:contain;height:160px;width:auto;transition:transform 0.3s ease;"
        onmouseover="this.style.transform='scale(1.07)'"
        onmouseout="this.style.transform='scale(1)'"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
      <!-- Fallback when image is missing -->
      <div style="display:none;align-items:center;justify-content:center;width:100%;height:100%;background:var(--bg-alt);">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--border)" stroke-width="1.5" stroke-linecap="round">
          <path d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V9l-6-6z"/>
          <polyline points="9 3 9 9 15 9"/>
        </svg>
      </div>
      <span style="position:absolute;top:0.75rem;right:0.75rem;display:inline-flex;align-items:center;gap:0.3rem;background:#DCFCE7;color:#15803D;font-size:0.68rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:999px;letter-spacing:0.02em;">
        <span style="width:5px;height:5px;background:#16A34A;border-radius:50%;display:inline-block;"></span>
        In Stock
      </span>
      {product.featured && (
        <span style="position:absolute;top:0.75rem;left:0.75rem;" class="badge badge-blue">
          Featured
        </span>
      )}
    </div>
  </a>

  <div style="padding:1.25rem;display:flex;flex-direction:column;flex:1;gap:0.5rem;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;">
      <span class={`badge ${badgeClass}`}>{product.category}</span>
      <span style="font-size:0.75rem;font-weight:700;color:var(--text-muted);">&gt;99% Purity</span>
    </div>

    <a href={`/products/${product.slug}`} style="text-decoration:none;color:inherit;">
      <h3 style="font-size:1.1rem;font-weight:700;margin:0.25rem 0;">{product.name}</h3>
    </a>

    <p style="font-size:0.82rem;color:var(--text-muted);line-height:1.55;flex:1;">
      {product.shortBenefit.length > 100 ? product.shortBenefit.slice(0, 97) + '...' : product.shortBenefit}
    </p>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.75rem;flex-wrap:wrap;gap:0.5rem;">
      <div>
        <span style="font-family:var(--font-head);font-weight:700;font-size:1.15rem;color:var(--dark);">
          {lowestPrice === highestPrice ? `€${lowestPrice}` : `€${lowestPrice}–€${highestPrice}`}
        </span>
        <span style="font-size:0.72rem;color:var(--text-faint);margin-left:0.25rem;">EUR</span>
      </div>
      <a href={`/products/${product.slug}`} class="btn btn-primary btn-sm">
        View Product
      </a>
    </div>
  </div>
</article>
